# Copy to .env and replace every placeholder before using Docker Compose.
APP_PORT=8080
DJANGO_SECRET_KEY=generate-a-unique-secret-key-with-at-least-50-random-characters
DJANGO_ALLOWED_HOSTS=app.example.com
FRONTEND_ORIGINS=https://app.example.com
POSTGRES_DB=vehicle_detection
POSTGRES_USER=vehicle_detection
POSTGRES_PASSWORD=replace-with-a-random-hex-password
REDIS_PASSWORD=replace-with-a-different-random-hex-password
DETECTION_EVENT_RETENTION_DAYS=30
